	type hbox_trade_client_list_item = vbox {
		datacontext = "[CharacterListItem.GetCharacter]"
		layoutpolicy_horizontal = expanding
		margin = { 10 0 }
		margin_top = 5
		margin_bottom = 12
		spacing = 4

		background = {
			using = Background_Area_With_Header
		}

		background = {
			using = Background_Frame
		}

		background = {
			using = Background_Trade_Entry_Pattern
			alpha = 0.4
			margin_top = -30
		}

		hbox = {
			layoutpolicy_horizontal = expanding

			vbox = {
				layoutpolicy_vertical = expanding
				margin_top = 2

				portrait_head_small = {}

				expand = {}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				margin_left = 10
				spacing = 4

				text_single = {
					text = "[Character.GetUINameNoTooltip|U]"
					layoutpolicy_horizontal = expanding
					autoresize = no
				}

				hbox = {
					spacing = 4
					ignoreinvisible = yes
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding

					hbox = {
						name = "company_size"
						datacontext = "[Character.GetActiveLawInGroupWithFlag('company_size')]"
						spacing = 4

						background = {
							using = Background_Area
							margin = { 15 5 }
						}

						tooltipwidget = {
							general_law_tooltip = {}
						}
						using = tooltip_se

						widget_company_size = {
							blockoverride "company_size_tooltip" {} #no tooltip
						}

						text_single = {
							text = "[Law.GetNameNoTooltip|U]"
							align = nobaseline
						}
					}

					expand = {}

					hbox = {
						spacing = 4

						background = {
							using = Background_Area
							margin_left = 10
							margin_right = -10
						}

						hbox_vassal_gold_tax = {
							datacontext = "[Character.GetTributaryContract]"

							blockoverride "tax_value" {
								text = "[ClientCharacterList.GetTaxContribution( CharacterListItem.Self )|=1]"
							}

							blockoverride "tax_breakdown" {
								datacontext = "[ClientCharacterList.GetTaxBreakdown( CharacterListItem.Self )]"
							}
						}

						button_round_interaction = {
							name = "suzerain_modify_tributary_contract_interaction"
							blockoverride "icon" {
								button_feudal_contract = {
									alwaystransparent = yes
									size = { 100% 100% }
								}
							}
						}
					}

					container = {
						visible = "[Not( MerchantHasCharterFromScopePatron( Character, GetPlayer ) )]"
						button_round = {
							name = "grant_merchant_charter_interaction"
							visible = "[And( Character.IsPlayerInteractionShown( PdxGuiWidget.GetName ), Character.IsValid )]"
							enabled = "[Character.IsPlayerInteractionValid( PdxGuiWidget.GetName )]"
							onclick = "[Character.OpenPlayerInteraction( PdxGuiWidget.GetName )]"
							tooltip = "[Character.GetPlayerInteractionTooltip( PdxGuiWidget.GetName )]"
							using = tooltip_se

							button_icon = {
								alwaystransparent = yes
								parentanchor = center
								size = { 24 24 }
								texture = "gfx/interface/icons/flat_icons/merchant_charter.dds"
							}
						}
					}

					container = {
						visible = "[MerchantHasCharterFromScopePatron( Character, GetPlayer )]"
						button_round = {
							name = "revoke_merchant_charter_interaction"
							visible = "[And( Character.IsPlayerInteractionShown( PdxGuiWidget.GetName ), Character.IsValid )]"
							enabled = "[Character.IsPlayerInteractionValid( PdxGuiWidget.GetName )]"
							onclick = "[Character.OpenPlayerInteraction( PdxGuiWidget.GetName )]"
							tooltip = "[Character.GetPlayerInteractionTooltip( PdxGuiWidget.GetName )]"
							using = tooltip_se

							button_icon = {
								alwaystransparent = yes
								parentanchor = center
								size = { 24 24 }
								texture = "gfx/interface/icons/flat_icons/revoke_merchant_charter.dds"
							}
						}
					}
				}
			}

		}

		hbox = {
			layoutpolicy_horizontal = expanding

			button_standard = {
				name = "commission_trade_route_interaction"
				size = { 480 33 }
				visible = "[And( Character.IsPlayerInteractionShown( PdxGuiWidget.GetName ), Character.IsValid )]"
				enabled = "[Character.IsPlayerInteractionValid( PdxGuiWidget.GetName )]"
				onclick = "[Character.OpenPlayerInteraction( PdxGuiWidget.GetName )]"
				text = "COMMISSION_TRADE_ROUTE_BUTTON_LABEL"
				tooltip = "[Character.GetPlayerInteractionTooltip( PdxGuiWidget.GetName )]"
				using = tooltip_se
			}
		}
	}
}

template Background_Trade_Good_Banner_Right {

	mirror = horizontal
	texture_density = 2

	texture = "gfx/interface/window_military/military_banner_gray.dds"
}

# Banner + grey overlay tint used on trade route / category entries
template Background_Trade_Good_Banner_Right_Tinted {

	mirror = horizontal
	texture_density = 2
	texture = "gfx/interface/window_military/military_banner_gray.dds"

	modify_texture = {
		texture = "gfx/interface/colors/grey.dds"
		blend_mode = overlay
		alpha = 0.2
	}
}

# Colored category wash behind route / category entries (set color/visible at call site)
template Background_Trade_Entry_Category {

	texture = "gfx/interface/component_tiles/tile_window_background_no_edge_grey.dds"
	alpha = 0.6

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
		mirror = vertical
		blend_mode = alphamultiply
	}

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_rough_edges.dds"
		spriteType = Corneredtiled
		spriteborder = { 25 25 }
		blend_mode = alphamultiply
	}
}

# Patterned fill used on trade route entries (override margin_top/alpha per entry if needed)
template Background_Trade_Entry_Pattern {

	texture = "gfx/interface/colors/black.dds"
	alpha = 0.3

	modify_texture = {
		texture = "gfx/interface/skinned/mask_pattern.dds"
		texture_density = 3
		spriteType = Corneredtiled
		blend_mode = alphamultiply
	}

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
		mirror = vertical
		blend_mode = alphamultiply
	}

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_rough_edges.dds"
		spriteType = Corneredtiled
		spriteborder = { 25 25 }
		blend_mode = alphamultiply
	}
}

template Background_Trade_Route_Item_Frame {

	background = {
		using = Background_Area_Solid
		margin = { 0 7 }
		alpha = 0.6
	}

	background = {
		using = Background_Frame
		margin = { 5 7 }
	}
}

template Button_Edit_Trade_Route {

	datacontext = "[TradeRouteItem.GetTradeRoute]"
	enabled = "[Not( TradeRoute.IsCommissionRoute )]"
	onclick = "[TradeWindow.EditTradeRoute( TradeRouteItem.GetTradeRoute )]"

	onmousehierarchyenter = "[TradeWindow.SetHoveredTradeRoute( TradeRoute.Self )]"
	onmousehierarchyleave = "[TradeWindow.ClearHoveredTradeRoute]"

	tooltip = "EDIT_TRADE_ROUTE_TT"
	tooltip_when_disabled = CANNOT_EDIT_CONTRACT_TRADE_ROUTE
}
