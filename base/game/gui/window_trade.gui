	type competitors_leaderboard_window = window {
		block "properties" {
			name = "competitors_leaderboard_window"
			position = { -600 0 }
			size = { 620 850 }
		}
		parentanchor = center|vcenter
		layer = top
		allow_outside = yes

		using = Window_Movable
		using = Window_Background
		using = Window_Decoration

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
		}

		vbox = {
			margin = { 35 15 }

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "TRADE_WINDOW_COMPETITORS_WINDOW_HEADER"
				}

				blockoverride "button_close"
				{
					onclick = "[CompetitorsLeaderboard.Close]"
				}
			}

			text_multi = {
				text = "TRADE_WINDOW_COMPETITORS_WINDOW_DESCRIPTION"
				default_format = "#weak"
				autoresize = yes
				max_width = 480
			}

			vbox_character_list = {
				datacontext = "[CompetitorsLeaderboard.AccessCharacterList]"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "skill_sort_buttons" {}

				blockoverride "container_implementation" {
					vbox = {
						name = "competitors_grid"
						datamodel = "[CharacterSelectionList.GetList]"
						visible = "[Not(CharacterSelectionList.IsBuildingList)]"

						spacing = 10
						layoutpolicy_horizontal = expanding

						item = {
							vbox_competitor_list_item = {
								datacontext = "[CharacterListItem.GetCharacter]"
								layoutpolicy_horizontal = expanding
							}
						}
					}

					text_single = {
						visible = "[Not(CharacterSelectionList.HasItems)]"
						layoutpolicy_vertical = expanding
						text = "TRADE_WINDOW_COMPETITORS_EMPTY"
					}
				}
			}

			expand = {}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin_bottom = 15

				button_primary = {
					text = "CLOSE_LABEL"
					onclick = "[CompetitorsLeaderboard.Close]"
				}
			}
		}
	}

	type vbox_competitor_list_item = vbox {

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 5 }

			background = {
				using = Background_Area_With_Header
			}

			background = {
				using = Background_Frame
			}

			background = {
				using = Background_Trade_Entry_Pattern
				alpha = 0.4
				margin_top = -30
			}

			vbox = {
				layoutpolicy_vertical = expanding
				margin_top = 2

				portrait_head_small = {}

				expand = {}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				margin_left = 10
				spacing = 4

				text_single = {
					text = "[Character.GetUINameNoTooltip|U]"
					layoutpolicy_horizontal = expanding
					autoresize = no
				}

				text_single = {
					text = "[Character.GetRelationToString( GetPlayer )]"
					layoutpolicy_horizontal = expanding
					autoresize = no
				}

				hbox = {
					layoutpolicy_horizontal = expanding


					hbox = {
						datacontext = "[Character.GetActiveLawInGroupWithFlag('company_size')]"
						spacing = 10

						background = {
							visible = "[Law.IsValid]"
							using = Background_Area_Dark
							alpha = 0.5
							margin = { 5 0 }
							margin_right = -25
						}

						background = {
							visible = "[Not(Law.IsValid)]"
							using = Background_Area_Dark
							alpha = 0.5
							margin = { 5 0 }
							margin_right = -50
						}

						hbox = {
							name = "shared_markets"
							spacing = 4
							tooltip = "TRADE_WINDOW_COMPETITORS_COL_SHARED_MARKETS_TOOLTIP"
							using = tooltip_se

							icon = {
								size = { 24 24 }
								texture = "gfx/interface/icons/trade/icon_trade_market.dds"
							}

							text_single = {
								text = "[CompetitorsLeaderboard.GetSharedMarketCountForItem( CharacterListItem.Self )|V0]"
								align = nobaseline
							}
						}

						divider_light = {
							layoutpolicy_vertical = expanding
						}

						hbox = {
							name = "shared_goods"
							spacing = 4
							tooltip = "TRADE_WINDOW_COMPETITORS_COL_SHARED_GOODS_TOOLTIP"
							using = tooltip_se

							icon = {
								size = { 24 24 }
								texture = "gfx/interface/icons/trade/icon_trade_goods.dds"
							}

							text_single = {
								text = "[CompetitorsLeaderboard.GetSharedGoodCountForItem( CharacterListItem.Self )|V0]"
								align = nobaseline
							}
						}

						divider_light = {
							layoutpolicy_vertical = expanding
						}

						hbox = {
							name = "competitiveness"
							spacing = 4
							tooltip = "TRADE_WINDOW_COMPETITORS_COL_COMPETITIVENESS_TOOLTIP"
							using = tooltip_se

							icon = {
								size = { 24 24 }
								texture = "gfx/interface/icons/trade/icon_trade_competitiveness.dds"
							}

							text_single = {
								text = "[CompetitorsLeaderboard.GetAggregateCompetitivenessForItem( CharacterListItem.Self )|V1]"
								align = nobaseline
							}

							spacer = {
								size = { 3 0 }
							}

							hbox = {
								# take up the space even when the character has no Company Size
								ignoreinvisible = no
								spacing = 4

								divider_light = {
									datacontext = "[Character.GetActiveLawInGroupWithFlag('company_size')]"
									visible = "[Law.IsValid]"
									layoutpolicy_vertical = expanding
								}
								widget_company_size = {
									visible = "[Law.IsValid]"
									using = tooltip_se
								}
							}



							spacer = {
								size = { 5 0 }
							}
						}
					}
					expand = {}

					hbox = {
						name = "house_relation"
						datacontext = "[Character.GetHouse]"
						datacontext = "[DynastyHouse.GetHouseRelationWith( GetPlayer.GetHouse )]"
						margin_right = 5
						spacing = 0

						background = {
							using = Background_Area_Light
							alpha = 0.5
							margin = { 5 -5 }
							margin_left = -15
						}

						background = {
							using = Background_Frame
							margin = { 5 -5 }
							margin_left = -15
						}

						coa_house_tiny = {}

						hbox = {
							visible = "[HouseRelation.IsValid]"
							datacontext = "[HouseRelation.GetLevel]"

							icon = {
								size = { 30 30 }
								texture = "[HouseRelationLevel.GetRenderedIcon]"
							}

							text_single = {
								text = "[HouseRelationLevel.GetNameNoTooltip|V]"
								align = nobaseline
							}

							tooltipwidget = {
								using = house_relation_level_tooltip
							}
							using = tooltip_se
						}

						text_single = {
							visible = "[Not(HouseRelation.IsValid)]"
							text = "NO_HOUSE_RELATION"
							align = nobaseline
							default_format = "#weak"
						}
					}
				}
			}
		}
	}

