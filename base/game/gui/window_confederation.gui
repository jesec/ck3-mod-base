	# Trade Monopolies
	type vbox_confederation_trade_monopolies = vbox {
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding

		scrollbox = {
			name = "confederation_monopolies"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			scrollbarpolicy_horizontal = always_off

			blockoverride "scrollbox_margins" {
				margin_top = 20
				margin_bottom = 15
				margin_left = 15
			}

			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[Confederation.GetTradeMonopolies]"
					item = {
						button_trade_monopoly_list_entry = {}
					}
				}
			}
			
			blockoverride "scrollbox_empty" {
				visible = "[Not(Confederation.HasTradeMonopoly)]"
				text = "CONFEDERATION_WINDOW_LEAGUE_NO_MONOPOLY"
				align = center
			}
		}
	}

	type button_trade_monopoly_list_entry = button_standard_clean {
		layoutpolicy_horizontal = expanding

		onclick = "[OpenGameViewData( 'trade_market_window', TradeMonopoly.GetTradeMarket.Self )]"

		hbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			restrictparent_min = yes

