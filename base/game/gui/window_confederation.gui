	type vbox_league_focus = vbox {
		layoutpolicy_horizontal = expanding

		background = {
			using = Background_Area_Dark
			alpha = 0.5
			margin = { 2 4 }
		}

		hbox_league_focus_row = {
			visible = "[Confederation.MakeScope.Var('league_focused_category').IsSet]"
