				name = "trade_monopoly_item"
				text = "[TradeMonopoly.GetTradeMarket.GetNameNoTooltip]"
				align = nobaseline
				layoutpolicy_horizontal = expanding
				autoresize = no
				default_format = "#clickable"
			}
		}
	}

	# Trade Posts of a trade league member's ruler and their Patricians
	type hbox_confederation_realm_trade_posts = hbox {
		margin = { 4 4 }
		spacing = 4

		tooltipwidget = {
			container = {
				using = GeneralTooltipSetup
				alwaystransparent = no

				object_tooltip_pop_out = {
					blockoverride "title_text" {
						default_format = "#T"
						text = "CONFEDERATION_WINDOW_REALM_TRADE_POSTS_TT"
					}

					blockoverride "concept_link" {}

					blockoverride "main_description" {
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2

							hbox_confederation_character_trade_posts = {
								visible = "[GreaterThan_int32( Character.GetNumTradePosts, '(int32)0' )]"
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 2
								datamodel = "[Character.GetVassals]"

								item = {
									hbox_confederation_character_trade_posts = {
										datacontext = "[SubjectContract.GetSubject]"
										visible = "[GreaterThan_CFixedPoint( Character.MakeScope.ScriptValue( 'gdp_patrician_trade_post_count_value' ), '(CFixedPoint)0' )]"
									}
								}
							}
						}
					}
				}
			}
		}

		icon = {
			name = "trade_post_icon"
			size = { 30 30 }
			texture = "gfx/interface/icons/trade/icon_trade_post.dds"
		}

		text_single = {
			name = "trade_post_count"
			max_width = 50
			text = "CONFEDERATION_WINDOW_REALM_TRADE_POSTS"
			align = nobaseline
			default_format = "#high"
		}
	}

	type hbox_confederation_character_trade_posts = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 4

		coa_house_microscopic = {
			datacontext = "[Character.GetHouse]"
		}

		text_single = {
			layoutpolicy_horizontal = expanding
			text = "CONFEDERATION_WINDOW_TRADE_POSTS_OWNER"
			align = nobaseline
			using = tooltip_es

			tooltipwidget = {
				container = {
					using = GeneralTooltipSetup
					alwaystransparent = no

					object_tooltip_pop_out = {
						blockoverride "title_text" {
							default_format = "#T"
							text = "CONFEDERATION_WINDOW_TRADE_POSTS_OWNER_TT"
						}

						blockoverride "concept_link" {}

						blockoverride "main_description" {
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[Character.GetTradePosts]"

								item = {
									text_single = {
										layoutpolicy_horizontal = expanding
										datacontext = "[District.GetHolding]"
										datacontext = "[Holding.GetProvince.GetTitle.GetTradeMarket]"
										text = "CHARACTER_VIEW_TRADE_POST_DISTRICT"
										align = nobaseline
									}
								}
							}
						}
					}
				}
			}
		}
	}

	# Profit Routes of a trade league member's ruler and their Patricians
	type hbox_confederation_realm_profit_routes = hbox {
		margin = { 4 4 }
		spacing = 4

		tooltipwidget = {
			container = {
				using = GeneralTooltipSetup
				alwaystransparent = no

				object_tooltip_pop_out = {
					blockoverride "title_text" {
						default_format = "#T"
						text = "CONFEDERATION_WINDOW_REALM_PROFIT_ROUTES_TT"
					}

					blockoverride "concept_link" {}

					blockoverride "main_description" {
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2

							hbox_confederation_character_profit_routes = {
								visible = "[GreaterThan_int32( Character.GetCurrentProfitRouteCount, '(int32)0' )]"
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 2
								datamodel = "[Character.GetVassals]"

								item = {
									hbox_confederation_character_profit_routes = {
										datacontext = "[SubjectContract.GetSubject]"
										visible = "[GreaterThan_CFixedPoint( Character.MakeScope.ScriptValue( 'gdp_patrician_profit_route_count_value' ), '(CFixedPoint)0' )]"
									}
								}
							}
						}
					}
				}
			}
		}

		icon = {
			name = "profit_route_icon"
			size = { 30 30 }
			texture = "gfx/interface/icons/trade/icon_trade_route.dds"
		}

		text_single = {
			name = "profit_route_count"
			max_width = 50
			text = "CONFEDERATION_WINDOW_REALM_PROFIT_ROUTES"
			align = nobaseline
			default_format = "#high"
		}
	}

	type hbox_confederation_character_profit_routes = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 4

		coa_house_microscopic = {
			datacontext = "[Character.GetHouse]"
		}

		text_single = {
			layoutpolicy_horizontal = expanding
			text = "CONFEDERATION_WINDOW_PROFIT_ROUTES_OWNER"
			align = nobaseline
			using = tooltip_es

			tooltipwidget = {
				container = {
					using = GeneralTooltipSetup
					alwaystransparent = no

					object_tooltip_pop_out = {
						blockoverride "title_text" {
							default_format = "#T"
							text = "CONFEDERATION_WINDOW_PROFIT_ROUTES_OWNER_TT"
						}

						blockoverride "concept_link" {}

						blockoverride "main_description" {
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[Character.GetTradeRoutes]"

								item = {
									text_single = {
										visible = "[TradeRoute.IsProfitRoute]"
										layoutpolicy_horizontal = expanding
										text = "CHARACTER_VIEW_PROFIT_ROUTE_NAME"
										align = nobaseline
									}
								}
							}
						}
					}
				}
			}
		}
	}

	type button_interactions_trade_league = button_round {
		visible = "[And3( Character.IsValid, Not( IsObserver ), Not( Character.IsLocalPlayer ) )]"
		tooltip = "CONFEDERATION_WINDOW_TRADE_LEAGUE_MEMBER_INTERACTIONS_TOOLTIP"
		tooltip_visible = "[Not( IsInteractionMenuOpenForCharacterWithFilter( Character.Self, 'interaction_category_trade_league' ) )]"

		onclick = "[ToggleFilteredCharacterInteractionMenu( Character.Self, 'interaction_category_trade_league' )]"

		button_icon = {
			alwaystransparent = yes
			parentanchor = center
			size = { 24 24 }
			texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
		}

		text_single = {
			position = { 0 3 }
			parentanchor = bottom|hcenter

			background = {
				margin = { 5 0 }
				margin_top = -5
				using = Background_Area_Dark
			}

			text = "[GetNumberOfValidInteractionsWithFilter( Character.Self, 'interaction_category_trade_league' )]"
			default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
		}
	}
}

local_template Confederation_Illustration_Background
{
	margin_right = -18
	alpha = 0.3
	using = Mask_Rough_Edges

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
		blend_mode = alphamultiply
		mirror = vertical
	}
}
