				text_single = {

					name = "character_relation_to_you"
					max_width = 350
					layoutpolicy_horizontal = expanding

					text = "[Character.GetRelationToString( GetPlayer )]"

					tooltip = "EXTENDED_RELATIONS_TOOLTIP"
					using = tooltip_se
					default_format = "#low"
				}
			}

			expand = {}

			vbox = {

				layoutpolicy_horizontal = expanding
				spacing = 8

				vbox_league_focus = {}

				button_standard = {
					layoutpolicy_horizontal = expanding
					size = { 0 32 }
					visible = "[Character.IsPlayerInteractionShown( 'request_trade_league_membership_interaction' )]"
					enabled = "[Character.IsPlayerInteractionValid( 'request_trade_league_membership_interaction' )]"
					onclick = "[Character.OpenPlayerInteraction( 'request_trade_league_membership_interaction' )]"
					tooltip = "[Character.GetPlayerInteractionTooltip( 'request_trade_league_membership_interaction' )]"
					using = tooltip_se

					text_single = {
						name = "request_trade_league_membership"
						layoutpolicy_horizontal = expanding
						text = "request_trade_league_membership_interaction"
						default_format = "#high"
						parentanchor = center|hcenter
						align = nobaseline
					}
				}

				button_standard = {
					layoutpolicy_horizontal = expanding
					size = { 0 32 }
					visible = "[Character.IsPlayerInteractionShown( 'request_league_leadership_interaction' )]"
					enabled = "[Character.IsPlayerInteractionValid( 'request_league_leadership_interaction' )]"
					onclick = "[Character.OpenPlayerInteraction( 'request_league_leadership_interaction' )]"
					tooltip = "[Character.GetPlayerInteractionTooltip( 'request_league_leadership_interaction' )]"
					using = tooltip_se

					text_single = {
						name = "request_league_leadership"
						layoutpolicy_horizontal = expanding
