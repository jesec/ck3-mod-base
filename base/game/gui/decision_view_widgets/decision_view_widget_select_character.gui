# Required controller: select_scope_object

vbox = {
	name = "decision_view_widget_select_character"
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	ignoreinvisible = yes

	scrollbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		size = { 545 200 }

		blockoverride "scrollbox_content" {
			vbox = {
				margin_top = 10
				datamodel = "[DecisionViewWidgetSelectScopeObject.GetEntries]"
				spacing = 6

				item = {
					button_standard = {
						size = { 500 100 }
						margin = { 10 10 }

						datacontext = "[SelectScopeObjectEntry.GetScopeObject.GetCharacter]"

						onclick = "[DecisionViewWidgetSelectScopeObject.OnSelect(SelectScopeObjectEntry.Self)]"
						enabled = "[SelectScopeObjectEntry.IsEnabled]"
						down = "[SelectScopeObjectEntry.IsSelected]"
						tooltip = "[SelectScopeObjectEntry.GetTooltip]"

						hbox = {
							layoutpolicy_horizontal = expanding
							margin = { 5 5 }
							portrait_head_small = {}
							vbox = {
							layoutpolicy_vertical = expanding
							margin = { 5 5 }
								spacing = 5
								text_single = {
									layoutpolicy_horizontal = expanding
									text = "DECISION_VIEW_CHARACTER_PICKER_NAME"
									using = Font_Size_Medium
									autoresize = yes
									align = nobaseline
									max_width = 400
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									text = "DECISION_VIEW_CHARACTER_PICKER_RELATION"
									using = Font_Size_Small
									default_format = "#low"
									autoresize = yes
									align = nobaseline
									max_width = 400
								}
								expand = {}
							}
							expand = {}
						}
					}
				}
			}
		}

		blockoverride "scrollbox_background_fade" {}
	}
}
