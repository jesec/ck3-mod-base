# Required controller: select_scope_object

vbox = {
	name = "decision_view_widget_select_tenet"
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	ignoreinvisible = yes

	scrollbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		size = { 545 200 }

		blockoverride "scrollbox_content" {
			vbox = {
				margin_top = 10
				datamodel = "[DecisionViewWidgetSelectScopeObject.GetEntries]"
				spacing = 6

				item = {
					button_standard = {
						size = { 450 60 }
						margin = { 10 10 }

						datacontext = "[SelectScopeObjectEntry.GetScopeObject.TenetType]"
						datacontext = "[GetPlayer.GetFaith]"

						onclick = "[DecisionViewWidgetSelectScopeObject.OnSelect(SelectScopeObjectEntry.Self)]"
						enabled = "[SelectScopeObjectEntry.IsEnabled]"
						down = "[SelectScopeObjectEntry.IsSelected]"
						tooltip = "[SelectScopeObjectEntry.GetTooltip]"

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 10
							margin_left = 10

							icon = {
								name = "option_icon"
								size = { 39 60 }
								texture = "[TenetType.GetIcon( GetPlayer().GetFaith )]"
							}

							vbox = {
								name = "option_info"

								layoutpolicy_vertical = expanding
								margin_bottom = 5

								text_single = {
									name = "option_type"
									text = "DECISION_VIEW_TENET_PICKER_NAME"
									max_width = 250
									align = left
								}
							}

							expand = {}
						}
					}
				}
			}
		}

		blockoverride "scrollbox_background_fade" {}
	}
}
