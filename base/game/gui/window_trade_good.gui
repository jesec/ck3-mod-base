######################################################
################### TRADE GOOD #######################
######################################################

window = {
	name = "window_trade_good"
	widgetid = "window_trade_good"

	allow_outside = yes
	movable = no
	layer = middle

	size = { 100% 100% }
	alwaystransparent = yes

	state = {
		name = _show
		using = Animation_FadeIn_Standard
		using = Sound_WindowShow_Standard
		using = Animation_FadeIn_Standard
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Standard
		using = Sound_WindowHide_Standard
		using = Animation_FadeOut_Standard
	}

	widget = {
		parentanchor = hcenter|bottom
		position = { -25 -32 }

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			
			ignoreinvisible = yes
			restrictparent_min = yes
			minimumsize = { 400 0 }
			spacing = 4

			expand = {}

			hbox_map_submode_row = {}

			active_trade_good_vbox = {}
		}
	}
}

types TradeGood
{
	type vbox_same_category_goods = vbox {
		datacontext = "[TradeGoodWindow.GetSelectedTradeGoodType.GetNeedCategory]"
		visible = "[GreaterThan_int32( TradeGoodCategory.GetTradeGoodTypesCount, '(int32)1' )]"
		margin = { 8 8 }

		background = {
			using = Background_Area_Dark
		}

		hbox = {
			datamodel = "[TradeGoodCategory.GetTradeGoodTypes]"
			icon = {
				datacontext = "[TradeGoodWindow.GetSelectedTradeGoodType.GetNeedCategory]"
				size = { 40 40 }
				texture = "[TradeGoodCategory.GetIcon]"
				tooltip = "TRADE_MAP_SAME_CATEGORY"
				using = tooltip_se
			}

			spacer = {
				size = { 8 0 }
			}

			item = {
				button_round = {
					size = { 40 40 }
					onclick = "[TradeGoodWindow.SetSelectedTradeGoodType( TradeGoodType.Self )]"
					onclick = "[TradeGoodType.PlaySelectSound]"
					alwaystransparent = "[ObjectsEqual( TradeGoodWindow.GetSelectedTradeGoodType, TradeGoodType.Self)]"

					tooltipwidget = trade_good_type_tooltip
					using = tooltip_ne
					blockoverride "call_to_action" {
						cooltip_paragraph = {
							text = "TRADE_GOOD_TYPE_TOOLTIP_CTA_SELECT"
							default_format = "#I"
							margin_bottom = 16
						}
					}


					highlight_icon = {
						size = { 24 24 }
						parentanchor = center
						texture = "[TradeGoodType.GetSmallIcon]"
					}

					glow = {
						visible = "[ObjectsEqual( TradeGoodWindow.GetSelectedTradeGoodType, TradeGoodType.Self)]"
				    	using = Color_Bright_Yellow
				    	glow_radius = 3
				    	using = Glow_Standard
					}
				}
			}
		}
	}

	type hbox_map_submode_row = hbox {
		ignoreinvisible = yes
		spacing = 4

		hbox_map_submodes = {}

		vbox_same_category_goods = {}
	}

	type hbox_map_submodes = hbox {
		visible = "[TradeGoodWindow.HasSelectedTradeGoodType]"
		margin = { 8 8 }
		spacing = 4

		background = {
			using = Background_Area_Dark
		}

		button_round = {
			name = "trade_submode_button"
			size = { 40 40 }

			onclick = "[TradeGoodWindow.SetMapSubmode( 'trade' )]"
			down = "[EqualTo_string( TradeGoodWindow.GetMapSubmode, 'trade' )]"
			alwaystransparent = "[EqualTo_string( TradeGoodWindow.GetMapSubmode, 'trade' )]"
			tooltip = "trade_goods_desc"
			using = tooltip_ne

			button_icon = {
				size = { 20 20 }
				parentanchor = center
				alwaystransparent = yes
				down = "[EqualTo_string( TradeGoodWindow.GetMapSubmode, 'trade' )]"

				texture = "gfx/interface/icons/flat_icons/map_modes/trade_markets.dds"
			}
		}

		button_round = {
			name = "potential_production_submode_button"
			size = { 40 40 }

			onclick = "[TradeGoodWindow.SetMapSubmode( 'potential_production' )]"
			down = "[EqualTo_string( TradeGoodWindow.GetMapSubmode, 'potential_production' )]"
			alwaystransparent = "[EqualTo_string( TradeGoodWindow.GetMapSubmode, 'potential_production' )]"

			tooltip = "trade_good_potential_production_desc"
			using = tooltip_ne

			button_icon = {
				size = { 20 20 }
				parentanchor = center
				alwaystransparent = yes
				down = "[EqualTo_string( TradeGoodWindow.GetMapSubmode, 'potential_production' )]"

				texture = "gfx/interface/icons/flat_icons/production.dds"
			}
		}
	}

	type active_trade_good_vbox = hbox {
		margin = { 8 8 }
		spacing = 16

		background = {
			using = Background_Area_Dark
			margin = { 64 0 }
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
				blend_mode = alphamultiply
			}
		}

		hbox = {
			spacing = 8
			vbox = {
				text_single = {
					text = "MAP_SUBMODE_HEADER"
					default_format ="#weak"
					align = nobaseline
				}

				hbox = {
					visible = "[TradeGoodWindow.HasSelectedTradeGoodType]"
					datacontext = "[TradeGoodWindow.GetSelectedTradeGoodType]"
					spacing = 8
					icon = {
						size = { 60 60 }
						texture = "[TradeGoodType.GetIcon]"
					}
					text_single = {
						visible = "[EqualTo_string( TradeGoodWindow.GetMapSubmode, 'potential_production' )]"
						text = TRADE_GOOD_WINDOW_FOCUSED_GOOD_PRODUCTION
						align = nobaseline
						using = Font_Size_Medium
					}

					text_single = {
						visible = "[EqualTo_string( TradeGoodWindow.GetMapSubmode, 'trade' )]"
						text = TRADE_GOOD_WINDOW_FOCUSED_GOOD_TRADE
						align = nobaseline
						using = Font_Size_Medium
					}

					button_close = {
						size = { 22 22 }
						onclick = "[TradeGoodWindow.Close]"
						tooltip = "CLOSE_TOOLTIP"
					}
				}

				hbox = {
					visible = "[Not( TradeGoodWindow.HasSelectedTradeGoodType )]"
					spacing = 8
					text_single = {
						text = TRADE_GOOD_WINDOW_NO_FOCUS_GOOD
						align = nobaseline
						using = Font_Size_Medium
					}
				}
			}
		}
	}
}
