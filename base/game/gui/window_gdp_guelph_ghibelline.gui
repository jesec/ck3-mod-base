												datacontext = "[SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetFuturePhaseByType( GetSituationType('guelph_ghibelline').GetPhaseType('ad_interim') )]"
												visible = "[FutureSituationPhase.HasPointsTakeoverType]"
												text = "gg_progressbar_catalyst_count"
												parentanchor = center
												align = nobaseline
											}
										}

										widget = {
											size = { 42 42 }
											position = { 36 0 }
											datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('dictatus_papae')]"
											tooltipwidget = {
												using = situation_phase_type_tooltip
											}

											background = {
												texture = "gfx/interface/window_regency/regency_level_bg.dds"
												margin = { 5 5 }
											}

											icon = {
												size = { 30 30 }
												parentanchor = center
												texture = "gfx/interface/icons/situations/guelph_ghibelline/guelph_ghibelline_dictatus_papae.dds"
											}
										}

										widget = {
											size = { 42 42 }
											parentanchor = right
											position = { -36 0 }
											datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('ad_interim')]"
											tooltipwidget = {
												using = situation_phase_type_tooltip
											}

											background = {
												texture = "gfx/interface/window_regency/regency_level_bg.dds"
												margin = { 5 5 }
											}

											icon = {
												size = { 38 38 }
												parentanchor = center
												texture = "gfx/interface/icons/situation_types/guelph_ghibelline.dds"
											}
										}
									}

									hbox = {
										margin_top = 8

										button_primary = {
											size = { 200 30 }
											margin = { 12 4 }
											text = "guelph_ghibelline_catalysts_button"
											visible = "[And( ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType( 'guelph_ghibelline' ).GetPhaseType( 'dictatus_papae' ) ), Not( GetVariableSystem.Exists( 'gg_catalyst_window' ) ) )]"
											onclick = "[GetVariableSystem.Set( 'gg_catalyst_window', 'true' )]"
										}

										button_primary = {
											size = { 200 30 }
											margin = { 12 4 }
											text = "guelph_ghibelline_catalysts_button"
											visible = "[And( ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType( 'guelph_ghibelline' ).GetPhaseType( 'dictatus_papae' ) ), GetVariableSystem.Exists( 'gg_catalyst_window' ) )]"
											onclick = "[GetVariableSystem.Clear( 'gg_catalyst_window' )]"
										}
									}

									vbox = {
										spacer = {
											size = { 28 1 }
										}

										hbox = { #Going from Dictatus Papae to either Repose or Agitation
											spacing = 30

											text_multi = {
												text = "gg_dictatus_papae_transition"
												max_width = 320
												autoresize = yes
												align = right
											}

											vbox = {
												spacing = 12

												icon = {
													size = { 38 38 }
													datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('repose')]"
													texture = "[SituationPhaseType.GetIcon]"
													tooltipwidget = {
														using = situation_phase_type_tooltip
													}

													background = {
														texture = "gfx/interface/window_regency/regency_level_bg.dds"
														margin = { 5 5 }
													}
												}

												icon = {
													size = { 38 38 }
													datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('agitation')]"
													texture = "[SituationPhaseType.GetIcon]"
													tooltipwidget = {
														using = situation_phase_type_tooltip
													}

													background = {
														texture = "gfx/interface/window_regency/regency_level_bg.dds"
														margin = { 5 5 }
													}
												}
											}
										}
									}
								}
							}

							vbox = { # Actions
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding

								name = "actions_area"
