						#Compromise from Guelph perspective
						vbox = {
							visible = "[ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCharacterParticipantGroup( GetPlayer ).Self, GetSituation( 'guelph_ghibelline' ).GetTopParticipantGroupByKey( 'guelph_leader' ).Self )]"

							vbox = {
								datacontext = "[GetSituation('guelph_ghibelline').GetTopParticipantGroupByKey('ghibelline_leader')]"
