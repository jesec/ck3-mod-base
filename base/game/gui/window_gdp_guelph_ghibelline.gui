					default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
					align = nobaseline

					background = {
						margin = { 12 4 }
						using = Mask_Rough_Edges
						using = Background_Area_Dark
					}
				}

				widget = {
					allow_outside = yes
					size = { 20 20 }

					coa_realm_tiny_crown = {
						position = { 0 -24 }
						visible = "[Character.HasLandedTitles]"
					}
				}

				widget = {
					allow_outside = yes
					size = { 50 0 }

					widget = {
						size = { 50 70 }
						position = { 0 -46 }
						allow_outside = yes

						vbox = {
							spacing = 8
							layoutpolicy_vertical = expanding
							portrait_opinion = {
								blockoverride "opinion_bg_alpha" {
									alpha = 0.6
								}
							}

							button_round = {
								visible = "[Not( ObjectsEqual( Character.Self, GetPlayer.Self ) )]"
								onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'interaction_category_diplomacy')]"
								tooltip = "SITUATION_INTERACTION_BUTTON"

								button_icon = {
									alwaystransparent = yes
									parentanchor = center
									size = { 30 30 }
									texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
								}

								text_single = {
									position = { 0 -8 }
									parentanchor = top|hcenter
									text = "[GetNumberOfValidInteractionsWithFilter(Character.Self, 'interaction_category_diplomacy')]"
									default_format = "#glow_color:{0.1,0.1,0.1,1.0}"

									background = {
										margin = { 6 0 }
										using = Background_Area_Dark
									}
								}
							}
						}
