######################################################
##################### SITUATION ######################
######################################################
window = {
	name = "window_gdp_guelph_ghibelline"
	widgetid = "window_gdp_guelph_ghibelline"
	datacontext = "[SituationWindow.GetSituation]"
	datacontext = "[GetVariableSystem]"
	datacontext = "[GetPlayer]"
	parentanchor = top|right
	layer = windows_layer
	movable = no
	allow_outside = yes

	using = Window_Size_MainTab

	state = {
		name = on_create
		trigger_on_create = yes
		on_start = "[GetVariableSystem.Set( 'potential_phases', 'true'  )]"
		on_start = "[GetVariableSystem.Clear( 'situation_endings' )]"
		on_start = "[GetVariableSystem.Clear( 'gg_catalyst_window' )]"
	}

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
		on_start = "[SetMapMode( 'situation' )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
		on_start = "[SetMapMode( 'realms' )]"
	}

	margin_widget = {
		size = { 100% 100% }
		margin = { 0 26 }
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins

				datacontext = "[SituationWindow.GetSelectedSubRegion]"
				datacontext = "[SituationSubRegion.GetCurrentPhase]"

				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				vbox = { # Header
					layoutpolicy_horizontal = expanding
					spacing = 6

					header_pattern = {
						layoutpolicy_horizontal = expanding

						blockoverride "header_text"
						{
							text = "SITUATION_GUELPH_GHIBELLINE_DEFINITE"
						}

						blockoverride "button_back"
						{
							onclick = "[OpenGameView( 'situations' )]"
						}

						blockoverride "button_close"
						{
							onclick = "[SituationWindow.Close]"
						}
					}
				}

				vbox  = {
					layoutpolicy_horizontal = expanding
					margin_bottom = 42

					# Reserved space for current
					widget = {
						name = "current_phase_area"
						size = { 560 88 }
					}

					# Leaders
					widget = {
						size = { 560 225 }

						### Ghibellines Pattern
						background = {
							texture = "gfx/interface/colors/white.dds"
							color = { 0.32 0.25 0.1 1 }
							margin = { 0 12 }

							alpha = 0.5

							modify_texture = {
								texture = "gfx/interface/component_overlay/overlay_texture.dds"

								texture_density = 2
								spriteType = Corneredtiled

								alpha = 0.7
							}

							modify_texture = {
								texture = "gfx/interface/component_overlay/seamless_noise.dds"

								texture_density = 2
								spriteType = Corneredtiled

								alpha = 0.7
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
								blend_mode = alphaMultiply
							}

							using = Mask_Rough_Edges
						}

						background = {
							texture = "gfx/interface/window_guelph_ghibelline/ghibelline_pattern.dds"
							margin = { 0 12 }

							texture_density = 5
							spriteType = Corneredtiled

							alpha = 0.5

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
								blend_mode = alphaMultiply
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
								blend_mode = alphaMultiply
								alpha = 0.6
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_scratches.dds"
								blend_mode = alphaMultiply
							}

							using = Mask_Rough_Edges
						}

						### Guelph Pattern
						background = {
							texture = "gfx/interface/colors/white.dds"
							color = { 0.1 0.16 0.25 1 }
							alpha = 0.5
							margin = { 0 12 }

							modify_texture = {
								texture = "gfx/interface/component_overlay/overlay_texture.dds"

								texture_density = 2
								spriteType = Corneredtiled

								alpha = 0.7
							}

							modify_texture = {
								texture = "gfx/interface/component_overlay/seamless_noise.dds"

								texture_density = 2
								spriteType = Corneredtiled

								alpha = 0.7
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
								blend_mode = alphaMultiply
								mirror = horizontal
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_scratches.dds"
								blend_mode = alphaMultiply
								alpha = 0.5
							}

							using = Mask_Rough_Edges
						}

						background = {
							texture = "gfx/interface/window_guelph_ghibelline/guelph_pattern.dds"
							margin = { 0 12 }
							texture_density = 5
							spriteType = Corneredtiled

							alpha = 0.16

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
								blend_mode = alphaMultiply
								mirror = horizontal
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
								blend_mode = alphaMultiply
								mirror = horizontal
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_scratches.dds"
								blend_mode = alphaMultiply
								alpha = 1
							}

							using = Mask_Rough_Edges
						}

						background = {
							texture = "gfx/interface/colors/black.dds"
							margin = { 0 12 }

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_vignette.dds"
								blend_mode = alphaMultiply
								alpha = 0.8
							}

							using = Mask_Rough_Edges
						}

						group_banner = {
							parentanchor = left
							position = { 12 -16 }

							blockoverride "group_text" {
								datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('guelph_advantage')]"
								datacontext = "[GetDecisionWithKey('guelph_victory_decision')]"
								text = "guelphs_concept"
							}
							blockoverride "group_icon" {
								texture = "gfx/interface/icons/situations/guelph_ghibelline/guelph_icon.dds"
							}
							blockoverride "group_banner_texture" {
								texture = "gfx/interface/window_guelph_ghibelline/group_banner.dds"
								color = { 0.4 0.5 0.6 1}
							}
						}

						group_banner = {
							parentanchor = right
							position = { -12 -16 }

							blockoverride "group_text" {
								datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('ghibelline_advantage')]"
								datacontext = "[GetDecisionWithKey('ghibelline_victory_decision')]"
								text = "ghibellines_concept"
							}
							blockoverride "group_icon" {
								texture = "gfx/interface/icons/situations/guelph_ghibelline/ghibelline_icon.dds"
							}
							blockoverride "group_banner_texture" {
								texture = "gfx/interface/window_guelph_ghibelline/group_banner.dds"
								color = { 0.65 0.55 0.4 1}
							}
						}


						widget = {
							size = { 50% 100% }
							datamodel = "[SituationParticipantGroup.GetCharacters]"
							datacontext = "[GetSituation('guelph_ghibelline').GetTopParticipantGroupByKey('guelph_leader')]"

							item = {
								widget = {
									size = { 100% 100% }

									portrait_button = {
										size = { 180 280 }
										parentanchor = center
										position = { 60 0 }
										using = portrait_base

										blockoverride "portrait_transformation"
										{
											portrait_scale = {  1.0 1.0 }
											portrait_offset = { 0 0 }
										}

										portrait_texture = "[Character.GetAnimatedPortrait( 'environment_body', 'camera_body_right_gg', 'war_defender', PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"
										background_texture = "gfx/portraits/portrait_transparent.dds"
										effectname = "NoHighlight"
										texture = "gfx/portraits/portrait_transparent.dds"
										mask = "gfx/portraits/portrait_mask_body.dds"
									}

									widget = {
										size = { 100% 50 }
										parentanchor = bottom|hcenter

										allow_outside = yes

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 12

											expand = {}

											widget = {
												allow_outside = yes
												size = { 50 0 }

												widget = {
													size = { 50 70 }
													position = { 0 -46 }
													allow_outside = yes

													vbox = {
														spacing = 8
														layoutpolicy_vertical = expanding
														portrait_opinion = {
															blockoverride "opinion_bg_alpha" {
																alpha = 0.6
															}
														}

														button_round = {
															visible = "[Not( ObjectsEqual( Character.Self, GetPlayer.Self ) )]"
															onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'interaction_category_situation')]"
															tooltip = "SITUATION_INTERACTION_BUTTON"

															button_icon = {
																alwaystransparent = yes
																parentanchor = center
																size = { 30 30 }
																texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
															}

															text_single = {
																position = { 0 -8 }
																parentanchor = top|hcenter
																text = "[GetNumberOfValidInteractionsWithFilter(Character.Self, 'interaction_category_situation')]"
																default_format = "#glow_color:{0.1,0.1,0.1,1.0}"

																background = {
																	margin = { 6 0 }
																	using = Background_Area_Dark
																}
															}
														}
													}
												}
											}

											widget = {
												allow_outside = yes
												size = { 34 20 }

												coa_realm_tiny_crown = {
													position = { 0 -24 }
													visible = "[Character.HasLandedTitles]"
												}
											}

											text_single = {
												text = "[Character.GetShortUINameNoTooltip]"
												default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
												align = nobaseline

												background = {
													margin = { 12 4 }
													using = Mask_Rough_Edges
													using = Background_Area_Dark
												}
											}
											expand = {}
										}
									}
								}
							}
						}

						widget = {
							size = { 50% 100% }
							datamodel = "[SituationParticipantGroup.GetCharacters]"
							datacontext = "[GetSituation('guelph_ghibelline').GetTopParticipantGroupByKey('ghibelline_leader')]"
							parentanchor = right
							position = { 0 0}

							item = {

								widget = {
									size = { 100% 100% }

									portrait_button = {
										size = { 180 280 }
										parentanchor = center
										position = { -50 0 }
										using = portrait_base

										blockoverride "portrait_transformation"
										{
											portrait_scale = {  1.0 1.0 }
											portrait_offset = { 0 0 }
										}

										portrait_texture = "[Character.GetAnimatedPortrait( 'environment_body', 'camera_body_left_gg', 'war_defender', PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"
										background_texture = "gfx/portraits/portrait_transparent.dds"
										effectname = "NoHighlight"
										texture = "gfx/portraits/portrait_transparent.dds"
										mask = "gfx/portraits/portrait_mask_body.dds"
									}

									widget = {
										size = { 100% 50 }
										parentanchor = bottom|hcenter

										allow_outside = yes

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 12

											expand = {}

											text_single = {
												text = "[Character.GetShortUINameNoTooltip]"
												default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
												align = nobaseline

												background = {
													margin = { 12 4 }
													using = Mask_Rough_Edges
													using = Background_Area_Dark
												}
											}


											widget = {
												allow_outside = yes
												size = { 34 20 }

												coa_realm_tiny_crown = {
													position = { 0 -24 }
													visible = "[Character.HasLandedTitles]"
												}
											}

											widget = {
												allow_outside = yes
												size = { 50 0 }

												widget = {
													size = { 50 70 }
													position = { 0 -46 }
													allow_outside = yes

													vbox = {
														spacing = 8
														layoutpolicy_vertical = expanding
														portrait_opinion = {
															blockoverride "opinion_bg_alpha" {
																alpha = 0.6
															}
														}

														button_round = {
															visible = "[Not( ObjectsEqual( Character.Self, GetPlayer.Self ) )]"
															onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'interaction_category_situation')]"
															tooltip = "SITUATION_INTERACTION_BUTTON"

															button_icon = {
																alwaystransparent = yes
																parentanchor = center
																size = { 30 30 }
																texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
															}

															text_single = {
																position = { 0 -8 }
																parentanchor = top|hcenter
																text = "[GetNumberOfValidInteractionsWithFilter(Character.Self, 'interaction_category_situation')]"
																default_format = "#glow_color:{0.1,0.1,0.1,1.0}"

																background = {
																	margin = { 6 0 }
																	using = Background_Area_Dark
																}
															}
														}
													}
												}
											}
											expand = {}
										}
									}
								}
							}
						}
					}

					widget = {
						allow_outside = yes
						widget = { # Current Phase area
							name = "current_phase_area"
							size = { 560 105 }
							position = { 0 -330}

							visible = "[Not( SituationWindow.GetSelectedFuturePhaseType.IsValid )]"

							background = {
								texture = "gfx/interface/window_guelph_ghibelline/phase_banner.dds"
							}

							vbox = {
								name = "current_phase_widget"
								datacontext = "[SituationWindow.GetSelectedSubRegion.GetCurrentPhase]"
								datacontext = "[GetPlayer]"
								allow_outside = yes
								layoutpolicy_horizontal = expanding

								expand = {}

								hbox = {
									layoutpolicy_horizontal = expanding

									hbox = {
										name = "current_phase_header"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										maximumsize = { 250 114 }
										margin_left = 25

										container = {
											name = "icon"

											icon = {
												size = { 74 74 }
												texture = "gfx/interface/icons/struggle_banners/icon_background_01.dds"
											}

											icon = {
												size = { 74 74 }
												texture = "[SituationSubRegion.GetCurrentPhase.GetType.GetIcon]"
											}
										}

										spacer = {
											size = { 5 10 }
										}

										vbox = {
											name = "text"
											layoutpolicy_horizontal = expanding
											minimumsize = { 170 1 }

											text_single = {
												layoutpolicy_horizontal = expanding
												text = "CURRENT_PHASE"
												max_width = 170
												margin_bottom = -8
												align = center
											}

											text_multi = {
												layoutpolicy_horizontal = expanding
												text = "[SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType.GetName]"
												max_width = 140
												using = Font_Size_Medium
												default_format = "#high"
												autoresize = yes
												align = center
												margin = { 0 6  }
											}
										}
									}

									spacer = {
										size = { 45 10 }
									}

									vbox = {
										name = "current_phase_effects"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										maximumsize = { 125 1 }
										margin_left = 35

										text_label_center = {
											text = "PHASE_EFFECTS_HEADER"
											default_format = "#high"
										}

										hbox = {
											name = "phase icons"
											layoutpolicy_vertical = expanding
											spacing = 6

											hbox = {
												layoutpolicy_horizontal = expanding

												fixedgridbox = {
													name = "named_effect_sets"
													layoutpolicy_horizontal = expanding

													addcolumn = 48
													addrow = 48
													setitemsizefromcell = yes
													datamodel_wrap = 6
													maxhorizontalslots = 6
													maxverticalslots = 2
													flipdirection = yes
													layoutanchor = topleft

													datamodel = "[SituationSubRegion.GetCurrentPhase.GetType.GetModifierNamedSets]"
													item = {
														button_phase_guelph_ghibelline_named_set_item = {}
													}
												}
											}
										}
									}
									expand = {}
								}

								expand = {}
							}
						}
					}

					widget = { # Current Progress Bar
						allow_outside = yes
						layoutpolicy_horizontal = expanding
						size = { 515 40 }

						progressbar_standard = {
							parentanchor = center
							position = { 0 2 }
							size = { 80% 26 }
							#visible = no

							blockoverride "progress_textures"
							{
								progresstexture = "gfx/interface/progressbars/progress_standard.dds"
								noprogresstexture = "gfx/interface/progressbars/progress_domicile_banner.dds"
							}

							value = "[EmptyScope.ScriptValue('situation_guelph_group_score')]"
							max = "[EmptyScope.ScriptValue('situation_guelph_ghibelline_score_total')]"

							tooltipwidget = {
								widget_value_breakdown_tooltip = {
									datacontext = "[EmptyScope.GetScriptValueBreakdown('situation_guelph_ghibelline_score_total')]"
								}
								blockoverride "header_text" {
									text = situation_gg_total_score_header
								}
							}
						}

						group_score = {
							blockoverride "text" {
								raw_text = "#E [EmptyScope.ScriptValue('situation_guelph_score_percentage')]%#!"
							}

							tooltipwidget = {
								widget_value_breakdown_tooltip = {
									datacontext = "[EmptyScope.GetScriptValueBreakdown('situation_guelph_group_score')]"
								}
								blockoverride "header_text" {
									text = situation_gg_guelph_score_header
								}
							}
						}

						icon = {
							size = { 132 25 }
							position = { 58 15 }
							texture = "gfx/interface/window_guelph_ghibelline/guelph_wall.dds"
						}

						group_score = {
							parentanchor = right
							blockoverride "text" {
								raw_text = "#Clickable [EmptyScope.ScriptValue('situation_ghibelline_score_percentage')]%#!"
							}

							tooltipwidget = {
								widget_value_breakdown_tooltip = {
									datacontext = "[EmptyScope.GetScriptValueBreakdown('situation_ghibelline_group_score')]"
								}
								blockoverride "header_text" {
									text = situation_gg_ghibelline_score_header
								}
							}
						}

						icon = {
							size = { 132 25 }
							position = { -58 15 }
							parentanchor = right
							texture = "gfx/interface/window_guelph_ghibelline/ghibelline_wall.dds"
						}

						icon = {
							size = { 38 38 }
							position = { -175 40 }
							parentanchor = right
							datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('guelph_advantage')]"
							texture = "[SituationPhaseType.GetIcon]"
							tooltipwidget = {
								using = situation_phase_type_tooltip
							}

							visible = "[ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType('guelph_ghibelline').GetPhaseType('agitation') )]"

							background = {
								texture = "gfx/interface/window_regency/regency_level_bg.dds"
								margin = { 5 5 }
							}
						}

						icon = {
							size = { 38 38 }
							position = { 175 40 }
							parentanchor = left
							datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('ghibelline_advantage')]"
							texture = "[SituationPhaseType.GetIcon]"
							tooltipwidget = {
								using = situation_phase_type_tooltip
							}

							visible = "[ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType('guelph_ghibelline').GetPhaseType('agitation') )]"

							background = {
								texture = "gfx/interface/window_regency/regency_level_bg.dds"
								margin = { 5 5 }
							}
						}

						icon = {
							size = { 38 38 }
							position = { -175 40 }
							parentanchor = right
							datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('guelph_advantage')]"
							texture = "[SituationPhaseType.GetIcon]"
							tooltip = "guelph_ghibelline_need_agitation_tt"

							visible = "[Not( Or( ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType('guelph_ghibelline').GetPhaseType('agitation') ), ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType('guelph_ghibelline').GetPhaseType('guelph_advantage') ) ) )]"
							enabled = no

							background = {
								texture = "gfx/interface/window_regency/regency_level_bg.dds"
								margin = { 5 5 }
							}
						}

						icon = {
							size = { 38 38 }
							position = { 175 40 }
							parentanchor = left
							datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('ghibelline_advantage')]"
							texture = "[SituationPhaseType.GetIcon]"
							tooltip = "guelph_ghibelline_need_agitation_tt"

							visible = "[Not( Or( ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType('guelph_ghibelline').GetPhaseType('agitation') ), ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType('guelph_ghibelline').GetPhaseType('ghibelline_advantage') ) ) )]"
							enabled = no

							background = {
								texture = "gfx/interface/window_regency/regency_level_bg.dds"
								margin = { 5 5 }
							}
						}

						icon = {
							size = { 38 38 }
							position = { -218 40 }
							parentanchor = right
							datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('agitation')]"
							texture = "[SituationPhaseType.GetIcon]"
							tooltip = "guelph_ghibelline_return_agitation_tt"

							visible = "[ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType, GetSituationType('guelph_ghibelline').GetPhaseType('guelph_advantage') ) ]"

							background = {
								texture = "gfx/interface/window_regency/regency_level_bg.dds"
								margin = { 5 5 }
							}
						}

						icon = {
							size = { 38 38 }
							position = { 218 40 }
							parentanchor = left
							datacontext = "[GetSituationType('guelph_ghibelline').GetPhaseType('agitation')]"
