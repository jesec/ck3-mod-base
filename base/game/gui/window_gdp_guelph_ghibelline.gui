	window_guelph_ghibelline_participant_groups = {
		datacontext = "[SituationWindow.AccessParticipantCharacterList]"
		datacontext = "[SituationParticipantCharacterList.AccessCharacterList]"
		visible = "[SituationParticipantCharacterList.IsVisible]"

		datacontext = "[SituationWindow.GetSelectedSubRegion]"
		blockoverride "header_text"
		{
			text = "[SituationWindow.GetParticipationWindowHeader]"
		}
	}

	guelph_ghibelline_catalysts_window = {}

	situation_gg_history_window = {
		visible = "[VariableSystem.Exists( 'situation_gg_history_window' )]"
		blockoverride "header_text"
		{
			text = "GG_WINDOW_HISTORY_LIST"
		}
	}
}

types GuelphGhibellineTypes
{
	type button_phase_guelph_ghibelline_named_set_item = button {
		datacontext = "[GetPlayer]"

		icon = {
			framesize = { 100 100 }
			parentanchor = center
			texture = "gfx/interface/buttons/button_tab_round.dds"
			size = { 90% 90% }
			color = { 0.6 0.75 0.9 1 }
		}

		icon = {
			size = { 70% 70% }
			parentanchor = center
			alwaystransparent = yes

			texture = "[SituationModifierNamedSet.GetIcon]"
		}

		tooltipwidget = {
			using = situation_modifier_named_set_tooltip
		}
	}

	type vbox_guelph_ghibelline_actions_area = vbox {
		name = "guelph_ghibelline_actions_tutorial_uses_this"
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		margin = { 8 8 }

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			margin_left = 5
			margin_right = 5

			#INTERACTIONS
			##Invite exiles?
			button_standard = {
				visible = "[Character.IsPlayerInteractionShown( 'gg_invite_guelph_exiles_interaction' )]"
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 33 }

				enabled = "[Character.IsPlayerInteractionValid( 'gg_invite_guelph_exiles_interaction' )]"
				onclick = "[Character.OpenPlayerInteraction( 'gg_invite_guelph_exiles_interaction' )]"

				tooltip = "[Character.GetPlayerInteractionTooltip( 'gg_invite_guelph_exiles_interaction' )]"
				tooltip_when_disabled = "[Character.GetPlayerInteractionValidBlockers( 'gg_invite_guelph_exiles_interaction' )]"

				text = "gg_invite_guelph_exiles_interaction"

				button_icon = {
					alwaystransparent = yes
					parentanchor = right
					margin_top = 5
					size = { 24 24 }
					texture = "gfx/interface/icons/flat_icons/add_character.dds"
				}
			}

			button_standard = {
				visible = "[Character.IsPlayerInteractionShown( 'gg_invite_ghibelline_exiles_interaction' )]"
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 33 }

				enabled = "[Character.IsPlayerInteractionValid( 'gg_invite_ghibelline_exiles_interaction' )]"
				onclick = "[Character.OpenPlayerInteraction( 'gg_invite_ghibelline_exiles_interaction' )]"

				tooltip = "[Character.GetPlayerInteractionTooltip( 'gg_invite_ghibelline_exiles_interaction' )]"
				tooltip_when_disabled = "[Character.GetPlayerInteractionValidBlockers( 'gg_invite_ghibelline_exiles_interaction' )]"

				text = "gg_invite_ghibelline_exiles_interaction"

				button_icon = {
					alwaystransparent = yes
					parentanchor = right
					margin_top = 5
					size = { 24 24 }
					texture = "gfx/interface/icons/flat_icons/add_character.dds"
				}
			}

			spacer = {
				size = { 5 10 }
				visible = "[Or( Character.IsPlayerInteractionShown( 'gg_invite_ghibelline_exiles_interaction' ), Character.IsPlayerInteractionShown( 'gg_invite_guelph_exiles_interaction' ) )]"
			}

			vbox = {
				name = "situation_decisions_container"
				spacing = 2

				layoutpolicy_horizontal = expanding

				datamodel = "[SituationWindow.GetSituationDecisions]"
				item = {
					button_decision_entry = {
						visible = "[Decision.IsShownForPlayer]"
						onclick = "[SituationWindow.OnDecisionClick( Decision.Self )]"
						blockoverride "button_size" {
							layoutpolicy_horizontal = expanding
						}
					}
				}
			}	
		}
	}

	type button_guelph_ghibelline_decision = button_decision_entry {
		visible = "[Decision.IsShownForPlayer]"
		layoutpolicy_horizontal = expanding
		onclick = "[OpenGameViewData( 'decision_detail', Decision.Self ) ]"
		using = tooltip_ws
	}

	type window_guelph_ghibelline_participant_groups = window  {
		name = "window_guelph_ghibelline_participant_groups"
		widgetanchor = right
		position = { 30 100 }
		size = { 740 82% }

		layer = middle
		movable = yes

		using = Window_Background
		using = Window_Decoration_Spike
		using = Window_Size_CharacterList

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
		}

		vbox = {
			using = Window_Margins

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "button_close"
				{
					onclick = "[SituationParticipantCharacterList.Close]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 8 0 }
				margin_bottom = 4

				background = {
					using = Background_Area
					margin = { 0 4 }
				}

				flowcontainer = {
					layoutstretchfactor_horizontal = 50

					datamodel = "[SituationSubRegion.GetParticipantGroups]"
					spacing = 10
					margin = { 10 10 }

					item = {
						button = {
							size = { 46 46 }
							visible = "[SituationParticipantGroup.IsValid]"
							onclick = "[SituationParticipantCharacterList.SetSelectedParticipantGroup( SituationParticipantGroup.Self )]"
							tooltip = "[SituationParticipantGroup.GetName]"

							icon = {
								visible = "[SituationParticipantCharacterList.IsParticipantGroupSelected( SituationParticipantGroup.Self )]"
								parentanchor = center

								texture = "gfx/interface/buttons/button_round_frame.dds"
								size = { 58 58 }
								color = { 0.75 0.75 0.65 1 }

								modify_texture = {
									texture = "gfx/interface/colors/gold.dds"
								}
							}

							icon_round_button_base = {
								parentanchor = center
								size = { 100% 100% }
								enabled = "[Not( SituationParticipantCharacterList.IsParticipantGroupSelected( SituationParticipantGroup.Self ) )]"
							}

							icon = {
								parentanchor = center
								size = { 36 36 }

								visible = "[SituationParticipantCharacterList.IsParticipantGroupSelected( SituationParticipantGroup.Self )]"
								texture = "[SituationParticipantGroup.GetType.GetIcon]"
								modify_texture = {
									texture = "gfx/interface/colors/colors_textured.dds"
									framesize = { 96 96 }
									frame = 1
								}
							}

							icon = {
								parentanchor = center
								size = { 36 36 }

								visible = "[Not( SituationParticipantCharacterList.IsParticipantGroupSelected( SituationParticipantGroup.Self ) )]"
								texture = "[SituationParticipantGroup.GetType.GetIcon]"
								alpha = "[Select_float(SituationParticipantCharacterList.IsParticipantGroupSelected( SituationParticipantGroup.Self ),'(float)1.0','(float)0.6')]"
								modify_texture = {
									texture = "gfx/interface/colors/colors_textured.dds"
									framesize = { 96 96 }
									frame = 1
								}
							}
						}
					}
				}
				expand = {}

				divider_light = {
					layoutpolicy_vertical = expanding
				}

				expand = {}

				vbox_participant_group_summary = {
					datacontext = "[SituationParticipantCharacterList.GetSelectedParticipantGroup]"

					layoutpolicy_vertical = expanding
					layoutstretchfactor_horizontal = 50
				}

				expand = {}
			}

			vbox_character_list = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "sort_buttons"
				{
					blockoverride "filters_visible" {
						visible = no
					}

					hbox_list_sort_buttons = {
						layoutpolicy_horizontal = expanding

						blockoverride "skill_sort_buttons" {}
					}
				}

				blockoverride "skill_sort_buttons" {}

				blockoverride "scrollbox_empty_visibility"
				{
					layoutpolicy_vertical = expanding
					visible = "[Not( CharacterSelectionList.HasItems )]"
					text = "SITUATION_PARTICIPANT_WINDOW_PARTICIPANT_EMPTY"
				}

				blockoverride "container_implementation"
				{
					fixedgridbox = {
						addcolumn = 630
						addrow = 92

						name = "characters_grid"
						datamodel_reuse_widgets = yes
						datamodel = "[CharacterSelectionList.GetList]"
						visible = "[Not(CharacterSelectionList.IsBuildingList)]"

						item = {
							widget_character_list_item_finder = {
								size = { 630 94 }
								blockoverride "character_relation" {}
							}
						}
					}
				}
			}
		}
	}

	type widget_guelph_leader = widget {
		size = { 220 225 }
		datacontext = "[GetSituation('guelph_ghibelline').GetTopParticipantGroupByKey('guelph_leader')]"



		widget = {
			size = { 200 50 }
			parentanchor = bottom|hcenter
			allow_outside = yes

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 12

				widget = {
					allow_outside = yes
					size = { 50 0 }

					widget = {
						size = { 50 70 }
						position = { 0 -46 }
						allow_outside = yes

						vbox = {
							spacing = 8
							layoutpolicy_vertical = expanding
							portrait_opinion = {
								blockoverride "opinion_bg_alpha" {
									alpha = 0.6
								}
							}

							button_round = {
								visible = "[Not( ObjectsEqual( Character.Self, GetPlayer.Self ) )]"
								onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'interaction_category_diplomacy')]"
								tooltip = "SITUATION_INTERACTION_BUTTON"

								button_icon = {
									alwaystransparent = yes
									parentanchor = center
									size = { 30 30 }
									texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
								}

								text_single = {
									position = { 0 -8 }
									parentanchor = top|hcenter
									text = "[GetNumberOfValidInteractionsWithFilter(Character.Self, 'interaction_category_diplomacy')]"
									default_format = "#glow_color:{0.1,0.1,0.1,1.0}"

									background = {
										margin = { 6 0 }
										using = Background_Area_Dark
									}
								}
							}
						}
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 22
					widget = {
						allow_outside = yes
						size = { 20 20 }

						coa_realm_tiny_crown = {
							position = { 0 -24 }
							visible = "[Character.HasLandedTitles]"
						}
					}

					text_single = {
						text = "[Character.GetShortUIName]"
						default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
						align = nobaseline

						background = {
							margin = { 12 4 }
							using = Mask_Rough_Edges
							using = Background_Area_Dark
						}
					}
					expand = {}
				}
			}
		}
	}

	type widget_ghibelline_leader = widget {
		size = { 220 225 }
		datacontext = "[GetSituation('guelph_ghibelline').GetTopParticipantGroupByKey('ghibelline_leader')]"

		portrait_button = {
			size = { 180 225 }
			position = { -10 20 }

			using = portrait_base

			portrait_texture = "[Character.GetAnimatedPortrait( 'environment_hud', 'camera_torso_right', 'war_over_win', PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"
			background_texture = "gfx/portraits/portrait_transparent.dds"
			effectname = "NoHighlight"
			texture = "gfx/portraits/portrait_transparent.dds"
			mask = "gfx/portraits/portrait_mask_body.dds"
		}

		widget = {
			size = { 200 50 }
			parentanchor = bottom|hcenter
			allow_outside = yes

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 12

