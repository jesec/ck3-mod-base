												align = center
											}
										}
									}
								}
							}
						}

						#Compromise from Ghibelline perspective
						vbox = {
							visible = "[ObjectsEqual( SituationWindow.GetSelectedSubRegion.GetCharacterParticipantGroup( GetPlayer ).Self, GetSituation( 'guelph_ghibelline' ).GetTopParticipantGroupByKey( 'ghibelline_leader' ).Self )]"

							vbox = {
								datacontext = "[GetSituation('guelph_ghibelline').GetTopParticipantGroupByKey('guelph_leader')]"
								visible = "[SituationParticipantGroup.IsValid]"
	
								#Enabled
								button_standard_clean = {
									size = { 180 300 }
									visible = "[Character.IsPlayerInteractionValid( 'gg_compromise_interaction' )]"
									
									datacontext_from_model = {
										datamodel = "[SituationParticipantGroup.GetCharacters]"
										index = 0
									}
		
									onclick = "[Character.OpenPlayerInteraction( 'gg_compromise_interaction' )]"
		
									tooltip = "[Character.GetPlayerInteractionTooltip( 'gg_compromise_interaction' )]"
		
									vbox = {
