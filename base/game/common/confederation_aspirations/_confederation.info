# TODO TIT-69469 Make a proper writeup when trade league design is settled on and we have a complete list of modifiers and parameters and settled whether levels should exist on both goal and confederation or only one of them
key = {
	# If a confederation aspiration should show in main HUD interface
	# Default: no
	show_in_main_hud = no

	# Default aspiration choice that a eligible confederation would start with
	is_default = no

	# Power level.
	# There must always be at least one.
	level = {

		# Modifiers for confederation head
		confederation_leader_modifier = {}

		# Modifiers for confederation members (also applied to the leader)
		confederation_member_modifier = {}

		# How much AI likes this power level
		# Used for initial power pick and to decide if upgrade current power or switch to a new one
		# root: confederation head
		ai_score = {}

		# Level "parameters" used to tag a level
		parameters = {}

		
		# Allows for requesting great project contributions from Allies when this level is active
		# Default: No
		#
		can_request_great_project_contributions_from_allies = no
	}

	# Texture used in the confederation attribute window
	illustration = "path/to/image.dds"

	# After changing confederation aspiration, how many days before you can change again?
	# days/weeks/months/years = X
	cooldown = { days = 7 }

	# Runs any designated effects when changing TO this aspiration
	# root = <character>
	# scope:confederation = <confederation>
	on_changed = {
	}
}
