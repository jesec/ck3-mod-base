# Name of activity group.
# Localization is formatted as "activity_group_type_<key>"
# Can be accessed with [ActivityGroupType.GetName]
# The keys activities, grand, unavailable, joinable and invitations are required by code
#
key = {

	# sort_order ( integer )
	# The order activity groups show up in the activity view.
	# Higher number is sorted first, tie breaking is on definition order.
	# Default is 0
	#
	sort_order = 0

	# gui_tags ( parameter list )
	# List of gui tags, used to set size, color, etc in gui views.
	# Can be defined as any string.
	# Checked with [ActivityGroupType.HasTag( 'tag_name' )]
	#
	gui_tags = { tag_1 tag_2 ... }
}
